          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#f28e2b' fontsize='20'>Inside Airbnb</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#f9a655' fontsize='12'>(Adding data to the debate)</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0' fontsize='12'>&quot;Inside Airbnb is a mission driven project that provides data and advocacy about Airbnb&apos;s impact on residential communities.</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0' fontsize='12'>We work towards a vision where communities are empowered with data and information to understand, decide and control the role of renting residential homes to tourists.&quot;</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run auto-url='true' fontalignment='0' fontcolor='#e1e1e6' fontname='Cascadia Code PL,Consolas,Courier New,monospace' fontsize='12' hyperlink='tabdoc:load-url url=&amp;quot;https://insideairbnb.com/get-the-data&amp;quot;'>https://insideairbnb.com/get-the-data</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='21317' id='7' story-point-id='8' type-v2='text' w='38209' x='3628' y='43638'>
          <formatted-text>
